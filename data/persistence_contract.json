    "boost": {"seconds": 600, "capSeconds": 1800, "showOnlyWhenFullQuoteFits": true, "consumeOnlyForegroundGameplay": true},
    "viewing": {"advanceOrdinaryEconomyAndRealTimers": true, "advanceBoostOrGameplayCounters": false, "createNewOfflineReceipt": false},
    "verificationRecovery": {"proposal": "client_immediate_plus_minimal_SSV_receipt_service", "serviceImplemented": false, "signatureVerificationRequired": true, "unknownEvidence": "retain_unresolved_no_auto_reward_no_second_ad_required_to_recover_existing_proof", "sdkAndSSVDedupBySameGrant": true},
    "privacy": {"requestOnlyAfterSDKConsentGate": true, "noNamesEmailOrFreeTextInCustomData": true, "secretsOnlyServer": true}
